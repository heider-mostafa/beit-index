# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================

# Supabase Project URL - from your Supabase project settings
SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Supabase Anon Key - public key for client-side auth
SUPABASE_ANON_KEY="your-anon-key"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Supabase Service Role Key - server-side only, never expose to client
# Used for admin operations that bypass RLS
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# API Server Port (default: 3001)
API_PORT=3001

# CORS: Allowed origins for API requests (comma-separated)
# Leave empty or unset for development (allows all origins)
# In production, set to your domain(s):
# ALLOWED_ORIGINS=https://beit-index.com,https://app.beit-index.com
ALLOWED_ORIGINS=

# =============================================================================
# PAYMENT GATEWAY (Paymob)
# =============================================================================

# Paymob API credentials - from Paymob Dashboard
PAYMOB_API_KEY="your-paymob-api-key"
PAYMOB_INTEGRATION_ID="your-integration-id"
PAYMOB_IFRAME_ID="your-iframe-id"
PAYMOB_HMAC_SECRET="your-hmac-secret"

# =============================================================================
# BACKGROUND JOBS (Inngest)
# =============================================================================

# Set to 1 for development, 0 for production
INNGEST_DEV=1

# =============================================================================
# ERROR MONITORING (Sentry)
# =============================================================================

# Sentry DSN for error tracking - get this from sentry.io
# Leave empty to disable Sentry (for development)
# SENTRY_DSN=https://xxxxx@yyy.ingest.sentry.io/zzz
SENTRY_DSN=

# Node environment: development | production
NODE_ENV=development
